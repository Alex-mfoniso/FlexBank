# Service Configuration
NODE_ENV=development
PORT=4000

# Database Connection (Prisma PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flexbank

# Cache Connection (Redis)
REDIS_URL=redis://localhost:6379

# Logging Level (error, warn, info, debug, trace)
LOG_LEVEL=info

# CORS Origin (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000,https://ricarut.vercel.app

# Security secrets (minimum 32 characters for security)
JWT_SECRET=your_32_characters_long_jwt_secret_key_here

# Financial Providers Configuration
DEFAULT_FINANCIAL_PROVIDER=paystack

# Paystack (Nigeria Bank Rail)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Safaricom M-Pesa (Kenya Mobile Money Rail)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=placeholder_consumer_key
MPESA_CONSUMER_SECRET=placeholder_consumer_secret
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=placeholder_initiator_password
MPESA_SECURITY_CREDENTIAL=placeholder_security_credential
MPESA_SHORTCODE=600988
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_RESULT_URL=https://your-domain.com/v1/webhooks/mpesa/b2c
MPESA_QUEUE_TIMEOUT_URL=https://your-domain.com/v1/webhooks/mpesa/b2c/timeout
MPESA_WEBHOOK_SECRET=placeholder_webhook_secret

