# Service Configuration
NODE_ENV=development
PORT=4000

# Database Connection (Prisma PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flexbank

# Cache Connection (Redis)
REDIS_URL=redis://localhost:6379

# Logging Level (error, warn, info, debug, trace)
LOG_LEVEL=info

# CORS Origin (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000

# Security secrets (minimum 32 characters for security)
JWT_SECRET=your_32_characters_long_jwt_secret_key_here
